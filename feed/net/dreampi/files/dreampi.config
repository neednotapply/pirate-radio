config dreampi 'main'
	# Answer the Dreamcast whenever a USB modem is plugged in
	option enabled '1'
	# ppp: DreamPi's servers, over a PPP link to this router (what a DreamPi
	# does). dcnet: Flycast's DCNet, for DCNet-patched games. Dialling *69
	# first picks DCNet for one call either way.
	option service 'ppp'
	# Play a dial tone into the line; '0' for a Dreamcast set to blind dial
	option dial_tone '1'
	# During PPP calls, tell Dreamcast Now (dreamcast.online/now) what is
	# being played, as DreamPi does: a hash of this router's MAC address and of
	# the game server name the Dreamcast last looked up
	option dcnow '1'
	# The modem; empty: the first known USB modem (/usr/share/dreampi/modems)
	option device ''
	option baud '57600'
	# DMZ, as DreamPi's guides advise for games that take incoming
	# connections: everything that comes in from the internet unasked goes to
	# the Dreamcast. Behind another router, make this router its DMZ host too.
	option dmz '0'
	# The PPP link: this router's end, and the Dreamcast's address
	option local_ip '192.168.169.1'
	option dreamcast_ip '192.168.169.2'
	# The Dreamcast's DNS servers: DreamPi's, which point retired game
	# servers' names at their revivals
	list dns '46.101.91.123'
	list dns '209.50.50.129'
	# Where retired game servers' fixed addresses go now (DreamPi's dcnatrules)
	option nat_rules_url 'https://shumania.ddns.net/dnat.txt'
	# pppd's debug output in the system log
	option debug '0'
