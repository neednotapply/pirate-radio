#!/bin/sh
# slate-gps: plug and play for a USB GPS. gpsd runs only while a GPS is
# plugged in; a GPS is any device listed in gpsd's config (gpsd.core.devices,
# /dev/ttyACM0 and /dev/ttyUSB0 by default) that exists and isn't a known
# other kind of serial device. The slate-gps init script syncs at boot, the
# tty hotplug hook on every plug and unplug.
#
#   slate-gps sync [gone]   start or stop gpsd to match; [gone] is a device
#                           being removed, counted as absent
#   slate-gps present       exit 0 if a GPS is plugged in

# Overridable for tests.
GPSD_INIT=${SLATE_GPSD_INIT:-/etc/init.d/gpsd}
DEV_ROOT=${SLATE_DEV_ROOT:-}
SYSFS=${SLATE_SYSFS:-/sys}
DREAMPI_LIB=${SLATE_DREAMPI_LIB:-/usr/share/dreampi/lib.sh}

# usb_id <device>: the vid:pid of the USB device a serial device belongs to.
usb_id() {
	local d
	d=$(readlink -f "$1") || return 1
	d="$SYSFS/class/tty/${d##*/}/device"
	[ -e "$d" ] || return 1
	d=$(readlink -f "$d") || return 1
	while [ -n "$d" ] && [ ! -r "$d/idVendor" ]; do d=${d%/*}; done
	[ -n "$d" ] && echo "$(cat "$d/idVendor"):$(cat "$d/idProduct")"
}

# is_gps <device>: not a serial device known to be something else, such as
# a PortaPack's USB console under Mayhem firmware (1d50:6018) or a USB modem
# DreamPi answers with, which take /dev/ttyACM0 like a GPS would.
is_gps() {
	local id
	id=$(usb_id "$1")
	case "$id" in
	1d50:6018) return 1 ;;
	esac
	if [ -n "$id" ] && [ -r "$DREAMPI_LIB" ]; then
		# shellcheck disable=SC1090
		. "$DREAMPI_LIB"
		dreampi_modem_name "$id" > /dev/null && return 1
	fi
	return 0
}

present() {
	local d gone="$1"
	for d in $(uci -q get gpsd.core.devices); do
		[ "$d" = "$gone" ] && continue
		[ -e "$DEV_ROOT$d" ] && is_gps "$DEV_ROOT$d" && return 0
	done
	return 1
}

case "$1" in
present) present ;;
sync)
	if present "$2"; then
		"$GPSD_INIT" start
	else
		"$GPSD_INIT" stop
	fi > /dev/null 2>&1
	;;
*)
	echo "usage: slate-gps sync [gone-device] | present" >&2
	exit 1
	;;
esac
