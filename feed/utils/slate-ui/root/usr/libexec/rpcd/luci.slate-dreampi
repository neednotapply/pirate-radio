#!/bin/sh
# rpcd plugin for the Slate web UI's DreamPi page. A thin wrapper over the
# slate-dreampi tool.
#
#   ubus call luci.slate-dreampi status
#   ubus call luci.slate-dreampi log
#   ubus call luci.slate-dreampi set '{"enabled":true,"service":"ppp","dial_tone":true,"dcnow":true}'

. /usr/share/libubox/jshn.sh

TOOL=${SLATE_DREAMPI:-/usr/sbin/slate-dreampi}

run_set() {
	local input enabled service dial_tone dcnow
	read -r input
	json_load "$input"
	json_get_var enabled enabled
	json_get_var service service
	json_get_var dial_tone dial_tone
	json_get_var dcnow dcnow
	"$TOOL" set "$enabled" "$service" "$dial_tone" "$dcnow"
}

case "$1" in
list)
	echo '{ "status": {}, "log": {}, "set": { "enabled": true, "service": "str", "dial_tone": true, "dcnow": true } }'
	;;
call)
	case "$2" in
	status) "$TOOL" status ;;
	log)    "$TOOL" log ;;
	set)    run_set ;;
	esac
	;;
esac
