#!/bin/sh
# First boot: have gpsd ready for the Wi-Fi survey's wardriving positions, so
# a USB GPS works when plugged in. Does nothing if gpsd is not installed.
# Plug and play: gpsd is not started at boot; slate-gps (its init script and
# tty hotplug hook) runs it only while a GPS is plugged in on one of these.

[ -f /etc/config/gpsd ] || exit 0
uci -q get gpsd.core > /dev/null || exit 0

uci -q batch <<-EOT
	set gpsd.core.enabled='1'
	delete gpsd.core.devices
	add_list gpsd.core.devices='/dev/ttyACM0'
	add_list gpsd.core.devices='/dev/ttyUSB0'
EOT
uci commit gpsd
/etc/init.d/gpsd disable 2>/dev/null
/etc/init.d/slate-gps enable 2>/dev/null

exit 0
