#!/bin/sh /etc/rc.common
# Plug and play for a USB GPS: gpsd runs only while a GPS is plugged in. At
# boot this starts gpsd if one is already there; after that the tty hotplug
# hook (/etc/hotplug.d/tty/20-slate-gps) keeps it in step. gpsd itself is not
# started at boot (95-slate-recon-gpsd disables it). Stop this to keep gpsd
# off whatever is plugged in.

START=60
STOP=40

ACTIVE=/var/run/slate-gps.active

start() {
	: > "$ACTIVE"
	/usr/sbin/slate-gps sync
}

stop() {
	rm -f "$ACTIVE"
	/etc/init.d/gpsd stop > /dev/null 2>&1
}
