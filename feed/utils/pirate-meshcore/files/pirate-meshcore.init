#!/bin/sh /etc/rc.common
# pirate-meshcore: a MeshCore radio on the USB port, for the Pirate Radio
# UI's Messenger tab (on ubus as pirate.meshcore). It waits for one to be
# plugged in, and finds it again when it comes back.

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pirate-meshcore
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
