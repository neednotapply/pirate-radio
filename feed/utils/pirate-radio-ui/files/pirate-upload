#!/bin/sh
# pirate-upload: CGI endpoint that stages a firmware image for the Pirate Radio UI.
# The browser PUTs (or POSTs) the raw image bytes; this writes them to $IMG and
# returns JSON. It only STAGES the file — it never flashes. Applying is a
# separate, authenticated ubus call (pirate.firmware apply) that re-verifies
# the image first, so staging a file here cannot by itself change the firmware.
#
# Served by uhttpd at /cgi-bin/pirate-upload.

IMG=${PIRATE_FIRMWARE_IMG:-/tmp/pirate-firmware.img}
MAX=${PIRATE_UPLOAD_MAX:-41943040}   # 40 MB; a sysupgrade image is well under this

# A signed-in session, from the page's cookie (pirate_sid: 32 hex digits,
# nothing else gets through), that rpcd lets make the call $1 $2. A
# visitor's page has none (its session is rpcd's unauthenticated one, which
# rpcd lets make neither). PIRATE_UBUS: a stand-in for ubus (tests)
signed_in() {
	local sid
	sid=$(printf '%s\n' "$HTTP_COOKIE" | tr ';' '\n' | sed -n 's/^ *pirate_sid=\([0-9a-f]\{32\}\) *$/\1/p' | head -n 1)
	[ -n "$sid" ] || return 1
	[ "$("${PIRATE_UBUS:-ubus}" call session access \
		"{\"ubus_rpc_session\":\"$sid\",\"scope\":\"ubus\",\"object\":\"$1\",\"function\":\"$2\"}" 2> /dev/null |
		jsonfilter -e '@.access' 2> /dev/null)" = true ]
}

printf 'Content-Type: application/json\r\n\r\n'

# Only a page signed in with the router's password (what it sends goes to
# RAM, which a stranger on the network could otherwise fill)
if ! signed_in pirate.firmware apply; then
	echo '{ "ok": false, "error": "sign in first: sending a firmware image needs the router'\''s password" }'
	exit 0
fi

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
if [ "$len" -le 0 ]; then echo '{ "ok": false, "error": "no data" }'; exit 0; fi
if [ "$len" -gt "$MAX" ]; then echo '{ "ok": false, "error": "image too large" }'; exit 0; fi

rm -f "$IMG" "$IMG.ok"
head -c "$len" > "$IMG"
got=$(wc -c < "$IMG" 2>/dev/null)
if [ "$got" = "$len" ]; then
	printf '{ "ok": true, "size": %s }\n' "$got"
else
	rm -f "$IMG"
	echo '{ "ok": false, "error": "upload truncated" }'
fi
