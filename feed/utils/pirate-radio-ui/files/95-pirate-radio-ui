#!/bin/sh
# Make sure uhttpd exposes the ubus JSON-RPC endpoint (/ubus) the Pirate Radio web UI
# calls, then reload uhttpd. The UI itself is served from /www at the web root.
# Idempotent.
if uci -q get uhttpd.main >/dev/null 2>&1; then
	if [ "$(uci -q get uhttpd.main.ubus_prefix)" != "/ubus" ]; then
		uci set uhttpd.main.ubus_prefix='/ubus'
		uci commit uhttpd
	fi
fi
/etc/init.d/uhttpd reload >/dev/null 2>&1

# The device's name, unless it has one already: umdns announces it, so the UI
# is at http://pirateradio.local/ on the device's network
if [ "$(uci -q get system.@system[0].hostname)" = OpenWrt ]; then
	uci set system.@system[0].hostname='PirateRadio'
	uci commit system
fi
exit 0
