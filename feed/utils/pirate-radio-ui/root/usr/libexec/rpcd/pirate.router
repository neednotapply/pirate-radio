#!/bin/sh
# rpcd plugin for the Pirate Radio web UI's router-basics methods. A thin wrapper over
# the pirate-router tool.
#
#   ubus call pirate.router status
#   ubus call pirate.router ports
#   ubus call pirate.router clients
#   ubus call pirate.router adblock '{"enabled":true}'   (omit to just read)
#   ubus call pirate.router usb_power_cycle

. /usr/share/libubox/jshn.sh

ROUTER=${PIRATE_ROUTER:-/usr/sbin/pirate-router}

run_adblock() {
	local input enabled
	read -r input
	json_load "$input"
	json_get_var enabled enabled
	case "$enabled" in
	1|true)  "$ROUTER" adblock on ;;
	0|false) "$ROUTER" adblock off ;;
	*)       "$ROUTER" adblock ;;
	esac
}

run_set_password() {
	local input pw proof caller
	read -r input
	json_load "$input"
	json_get_var pw password
	# proof: a session the page signed in with the current password, just
	# now; ubus_rpc_session: the caller's own (uhttpd adds it)
	json_get_var proof proof
	json_get_var caller ubus_rpc_session
	# All of it goes to the tool on stdin, never on its command line.
	printf '%s\n%s\n%s\n' "$pw" "$proof" "$caller" | "$ROUTER" set_password
}

run_wifi_join() {
	local input ssid enc key
	read -r input
	json_load "$input"
	json_get_var ssid ssid
	json_get_var enc enc
	json_get_var key key
	# The key goes on stdin; the SSID and encryption are plain arguments.
	printf '%s' "$key" | "$ROUTER" wifi_join "$ssid" "$enc"
}

case "$1" in
list)
	echo '{ "status": {}, "ports": {}, "clients": {}, "adblock": { "enabled": false }, "set_password": { "password": "str", "proof": "str" }, "wifi_status": {}, "wifi_scan": {}, "wifi_join": { "ssid": "str", "enc": "str", "key": "str" }, "usb_power_cycle": {} }'
	;;
call)
	case "$2" in
	status)       "$ROUTER" status ;;
	ports)        "$ROUTER" ports ;;
	clients)      "$ROUTER" clients ;;
	adblock)      run_adblock ;;
	set_password) run_set_password ;;
	wifi_status)  "$ROUTER" wifi_status ;;
	wifi_scan)    "$ROUTER" wifi_scan ;;
	wifi_join)    run_wifi_join ;;
	usb_power_cycle) "$ROUTER" usb_power_cycle ;;
	esac
	;;
esac
