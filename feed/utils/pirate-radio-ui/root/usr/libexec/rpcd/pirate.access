#!/bin/sh
# rpcd plugin for the Pirate Radio web UI's Access and Terminal pages. A thin
# wrapper over the pirate-access tool.
#
#   ubus call pirate.access ssh_status
#   ubus call pirate.access ssh_set '{"port":22,"passwords":true}'
#   ubus call pirate.access ssh_key_add '{"key":"ssh-ed25519 AAAA… you@computer"}'
#   ubus call pirate.access ssh_key_remove '{"fingerprint":"SHA256:…"}'
#   ubus call pirate.access session_end '{"pid":1234}'
#   ubus call pirate.access term_status
#   ubus call pirate.access term_set '{"enabled":true}'

. /usr/share/libubox/jshn.sh

ACCESS=${PIRATE_ACCESS:-/usr/sbin/pirate-access}
# Set by json_get_var
input='' port='' pw='' key='' fp='' pid='' on=''

onoff() {
	case "$1" in
	1|true) echo on ;;
	0|false) echo off ;;
	*) echo "$1" ;;
	esac
}

case "$1" in
list)
	echo '{ "ssh_status": {}, "ssh_set": { "port": 22, "passwords": true }, "ssh_key_add": { "key": "str" }, "ssh_key_remove": { "fingerprint": "str" }, "session_end": { "pid": 0 }, "term_status": {}, "term_set": { "enabled": true } }'
	;;
call)
	case "$2" in
	ssh_status|term_status)
		"$ACCESS" "$2"
		;;
	ssh_set)
		read -r input
		json_load "$input"
		json_get_var port port
		json_get_var pw passwords
		"$ACCESS" ssh_set "$port" "$(onoff "$pw")"
		;;
	ssh_key_add)
		read -r input
		json_load "$input"
		json_get_var key key
		printf '%s\n' "$key" | "$ACCESS" ssh_key_add
		;;
	ssh_key_remove)
		read -r input
		json_load "$input"
		json_get_var fp fingerprint
		"$ACCESS" ssh_key_remove "$fp"
		;;
	session_end)
		read -r input
		json_load "$input"
		json_get_var pid pid
		"$ACCESS" session_end "$pid"
		;;
	term_set)
		read -r input
		json_load "$input"
		json_get_var on enabled
		"$ACCESS" term_set "$(onoff "$on")"
		;;
	esac
	;;
esac
