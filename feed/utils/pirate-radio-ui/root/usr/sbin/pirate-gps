#!/bin/sh
# pirate-gps: plug and play for a USB GPS. gpsd runs only while a GPS is
# plugged in; a GPS is any device listed in gpsd's config (gpsd.core.devices,
# /dev/ttyACM0 and /dev/ttyUSB0 by default) that exists and isn't a known
# other kind of serial device. The pirate-gps init script syncs at boot, the
# tty hotplug hook on every plug and unplug.
#
#   pirate-gps sync [gone]   start or stop gpsd to match; [gone] is a device
#                           being removed, counted as absent
#   pirate-gps present       exit 0 if a GPS is plugged in

# Overridable for tests.
GPSD_INIT=${PIRATE_GPSD_INIT:-/etc/init.d/gpsd}
DEV_ROOT=${PIRATE_DEV_ROOT:-}
SYSFS=${PIRATE_SYSFS:-/sys}
DREAMPI_LIB=${PIRATE_DREAMPI_LIB:-/usr/share/dreampi/lib.sh}

# usb_dir <device>: the sysfs folder of the USB device a serial device
# belongs to.
usb_dir() {
	local d
	d=$(readlink -f "$1") || return 1
	d="$SYSFS/class/tty/${d##*/}/device"
	[ -e "$d" ] || return 1
	d=$(readlink -f "$d") || return 1
	while [ -n "$d" ] && [ ! -r "$d/idVendor" ]; do d=${d%/*}; done
	[ -n "$d" ] && echo "$d"
}

# usb_id <device>: the vid:pid of the USB device a serial device belongs to.
usb_id() {
	local d
	d=$(usb_dir "$1") || return 1
	echo "$(cat "$d/idVendor"):$(cat "$d/idProduct")"
}

# usb_product <device>: what that USB device says it is.
usb_product() {
	local d
	d=$(usb_dir "$1") || return 1
	cat "$d/product" 2> /dev/null
}

# is_gps <device>: not a serial device known to be something else, such as
# a PortaPack's USB console under Mayhem firmware (1d50:6018), a Flipper
# Zero's CLI (0483:5740, pirate-flipper's), an nRF52 radio on Adafruit's
# bootloader (239a:*: a MeshCore one such as a T-Echo, pirate-meshcore's;
# its own GPS comes through it), an ESP32 board on the chip's own USB
# (Espressif's 303a:*, pirate-esp's) or a USB modem DreamPi answers with,
# which take /dev/ttyACM0 like a GPS would; or an M5Stack board (the
# M5StickC and C Plus: a first ESP32 behind an FTDI that says "M5stack",
# pirate-esp's and pirate-bluetooth's), which takes /dev/ttyUSB0.
is_gps() {
	local id
	id=$(usb_id "$1")
	case "$id" in
	1d50:6018 | 0483:5740 | 239a:* | 303a:*) return 1 ;;
	esac
	[ "$id" = 0403:6001 ] && [ "$(usb_product "$1")" = M5stack ] && return 1
	if [ -n "$id" ] && [ -r "$DREAMPI_LIB" ]; then
		# shellcheck disable=SC1090
		. "$DREAMPI_LIB"
		dreampi_modem_name "$id" > /dev/null && return 1
	fi
	return 0
}

present() {
	local d gone="$1"
	for d in $(uci -q get gpsd.core.devices); do
		[ "$d" = "$gone" ] && continue
		[ -e "$DEV_ROOT$d" ] && is_gps "$DEV_ROOT$d" && return 0
	done
	return 1
}

case "$1" in
present) present ;;
sync)
	if present "$2"; then
		"$GPSD_INIT" start
	else
		"$GPSD_INIT" stop
	fi > /dev/null 2>&1
	;;
*)
	echo "usage: pirate-gps sync [gone-device] | present" >&2
	exit 1
	;;
esac
