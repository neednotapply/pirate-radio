#!/bin/sh /etc/rc.common
# The USB port at boot. What is plugged in while the router starts and has
# not answered when the kernel asked what it was gets a second try, with
# its power gone in between. Where this firmware can switch the port's
# power (a full source build), pirate-router usb_recover switches the port
# off and on if what is plugged in has not answered, twice at most;
# elsewhere it does nothing. Run once at start, beside the rest of the
# boot, and early in it: before the jobs and the sharing of drives start, so
# that nothing is in use when the port goes off. The Status page has the
# same switch by hand.

START=15
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pirate-router usb_recover
	procd_close_instance
}
