#!/bin/sh
# Plug and play for USB drives (/etc/hotplug.d/block/30-pirate-usb): mount a
# drive that is plugged in, unmount one that is pulled out (pirate-usb), then
# share what is mounted (the pirate-usb init script). block-mount's own hook
# (10-mount) has mounted what fstab names by now; pirate-usb leaves that be.

case "$ACTION" in add | remove) ;; *) exit 0 ;; esac
case "$DEVNAME" in sd*) ;; *) exit 0 ;; esac

# Only once pirate-usb has started since boot, and not been stopped since.
[ -e "${PIRATE_USB_ACTIVE:-/var/run/pirate-usb.active}" ] || exit 0

# PIRATE_USB, PIRATE_USB_INIT: others to run (tests). Reload only when a
# drive was mounted or unmounted.
"${PIRATE_USB:-/usr/sbin/pirate-usb}" "$ACTION" "$DEVNAME" || exit 0
exec "${PIRATE_USB_INIT:-/etc/init.d/pirate-usb}" reload
