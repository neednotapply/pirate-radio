#!/bin/sh /etc/rc.common
# pirate-bluetooth: a Bluetooth dongle on the USB port, for the Pirate Radio
# UI's Bluetooth page (on ubus as pirate.bluetooth). It waits for a dongle to
# be plugged in, and has it listen only while a page looks.

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pirate-bluetooth
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
