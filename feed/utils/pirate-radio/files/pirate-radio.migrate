#!/bin/sh
# First boot after an upgrade that kept the settings: brings settings from
# before up to date. From slate-sdr, as this project was called before, its
# settings become pirate-radio's, and a card labelled SLATESDR still mounts;
# jobs that came later are added. Runs before pirate-radio's own first-boot
# script (90-pirate-radio). The card's slate-sdr/ folder is renamed when the
# card is first used (pirate_storage_load).

if [ -f /etc/config/slate-sdr ]; then
	mv /etc/config/slate-sdr /etc/config/pirate-radio
	if [ "$(uci -q get pirate-radio.storage.dir)" = slate-sdr ]; then
		uci set pirate-radio.storage.dir='pirate-radio'
		uci commit pirate-radio
	fi
fi

# The receiver in the web UI (the Listen page) came later: settings kept from
# before it get its job, switched on as a fresh install has it
if [ -f /etc/config/pirate-radio ] && ! uci -q get pirate-radio.websdr > /dev/null; then
	uci -q batch <<-EOT
		set pirate-radio.websdr=job
		set pirate-radio.websdr.type='websdr'
		set pirate-radio.websdr.enabled='1'
		commit pirate-radio
	EOT
fi

# The old card mount (label SLATESDR) stays, beside the new PIRATERADIO one
if uci -q get fstab.slatesdr > /dev/null; then
	uci rename fstab.slatesdr=sdcard_slatesdr
	uci commit fstab
fi

# The card's file server on port 8081 keeps its settings under the new name
if uci -q get uhttpd.slatesdr > /dev/null; then
	uci rename uhttpd.slatesdr=pirateradio
	uci commit uhttpd
fi

exit 0
