#!/bin/sh /etc/rc.common
# pirate-radio: one procd instance per enabled job in /etc/config/pirate-radio whose
# radio is on USB. Plug and play: /etc/hotplug.d/usb/20-pirate-radio reloads this
# service when an RTL-SDR or HackRF is plugged in or removed, so a job (and
# its receiver) runs only while its radio is there.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/pirate-radio-job

start_job() {
	local cfg="$1" enabled type need radio dev claim
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get type "$cfg" type

	need=$(pirate_job_needs "$cfg" "$type")
	if ! pirate_need_met "$need"; then
		[ "$need" = any ] && need=SDR
		logger -t pirate-radio "job '$cfg' waits: no $need on USB (it starts when one is plugged in)"
		return 0
	fi

	radio=$(pirate_job_radio "$cfg" "$type")
	if [ -n "$radio" ]; then
		config_get dev "$cfg" device 0
		claim="$radio:$dev"
		case " $CLAIMED " in
		*" $claim "*)
			logger -t pirate-radio "job '$cfg' not started: its $radio is taken by another enabled job"
			return 0
			;;
		esac
		CLAIMED="$CLAIMED $claim"
	fi

	if [ "$type" = wifi_spectral ] && [ -z "$(pirate_spectral_dirs)" ]; then
		logger -t pirate-radio "job '$cfg' not started: this firmware has no Wi-Fi spectral scan (use the full build)"
		return 0
	fi

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" "$cfg"
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	. /usr/share/pirate-radio/lib.sh
	CLAIMED=
	config_load pirate-radio
	config_foreach start_job job
	# Started since boot (and not stopped since): the hotplug hook may reload.
	mkdir -p "$PIRATE_STATE" && : > "$PIRATE_STATE/active"
}

stop_service() {
	. /usr/share/pirate-radio/lib.sh
	rm -f "$PIRATE_STATE/active"
}

service_triggers() {
	procd_add_reload_trigger pirate-radio
}
