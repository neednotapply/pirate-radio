#!/bin/sh
# First boot: mount the microSD card labelled PIRATERADIO at /mnt/sdcard, serve
# its contents (directory listings) on port 8081, and leave the aircraft map
# to the ADS-B job.

[ -f /etc/config/fstab ] || touch /etc/config/fstab
uci -q get fstab.pirateradio > /dev/null || uci -q batch <<-EOT
	set fstab.pirateradio=mount
	set fstab.pirateradio.target='/mnt/sdcard'
	set fstab.pirateradio.label='PIRATERADIO'
	set fstab.pirateradio.options='rw,noatime'
	set fstab.pirateradio.enabled='1'
	commit fstab
EOT

uci -q get uhttpd.pirateradio > /dev/null || uci -q batch <<-EOT
	set uhttpd.pirateradio=uhttpd
	add_list uhttpd.pirateradio.listen_http='0.0.0.0:8081'
	add_list uhttpd.pirateradio.listen_http='[::]:8081'
	set uhttpd.pirateradio.home='/mnt/sdcard'
	set uhttpd.pirateradio.rfc1918_filter='1'
	set uhttpd.pirateradio.max_requests='3'
	set uhttpd.pirateradio.max_connections='20'
	set uhttpd.pirateradio.network_timeout='30'
	set uhttpd.pirateradio.http_keepalive='20'
	commit uhttpd
EOT

# The aircraft map on port 8080 runs with the ADS-B job (pirate-radio-job), not
# around the clock: drop the always-on instance that dump1090's own first-boot
# script (00_uhttpd_dump1090, which runs before this one) adds.
if uci -q get uhttpd.dump1090 > /dev/null; then
	uci -q delete uhttpd.dump1090
	uci commit uhttpd
fi

exit 0
