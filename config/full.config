# Full source build: what the ImageBuilder cannot change.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y
CONFIG_TARGET_ath79_nand_DEVICE_glinet_gl-ar750s-nor-nand=y

# Spectral scan of both Wi-Fi radios through debugfs (selects KERNEL_RELAY,
# which the release kernel does not have).
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_ATH_SPECTRAL=y

# The 5 GHz QCA9887 on the upstream ath10k driver and Qualcomm's firmware,
# the combination spectral scan is known to work with, instead of the
# device's default ath10k-ct.
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
# CONFIG_PACKAGE_ath10k-firmware-qca9887-ct is not set
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-firmware-qca9887=y

# The Phone tab's USB-audio (MIDI) kmod rides on the ALSA sound subsystem,
# which is gated by AUDIO_SUPPORT - off by default on ath79, so enable it here
# (kmod-sound-core depends on it). The webcam (UVC) path needs no such symbol;
# naming kmod-video-core in packages.txt is enough. There is no VIDEO_SUPPORT
# symbol to set.
CONFIG_AUDIO_SUPPORT=y

# Name the image openwrt-<version>-pirate-radio-full-..., next to the quick
# build's openwrt-<version>-pirate-radio-...
CONFIG_IMAGEOPT=y
CONFIG_EXTRA_IMAGE_NAME="pirate-radio-full"
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
